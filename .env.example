# Copy to .env and fill in. Never commit .env.

# mock = runs fully offline with canned detections and suggestions (demo + tests)
# live = calls SAM 3 on fal.ai and Claude
RENOVAI_AI_MODE=mock

# Claude: design suggestions and kitchen description
ANTHROPIC_API_KEY=
RENOVAI_ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high: more thinking is slower and costs more; empty = model default
RENOVAI_ANTHROPIC_EFFORT=low

# fal.ai: SAM 3 surface and object detection ($0.005 per call: two surfaces plus one call per
# object Claude lists on the counter and backsplash)
FAL_KEY=
RENOVAI_SAM3_MIN_SCORE=0.35

# Our own model worker (workers/gpu): Marigold-IID-Lighting for the room's light. Deploy it with
# `modal deploy workers/gpu/modal_app.py` (or run it on a GPU box or a Mac) and put its address
# and token here. Empty = the renderer estimates the light from the photo itself.
RENOVAI_WORKER_URL=
RENOVAI_WORKER_TOKEN=

# Key your field team types to see visit requests at /#/staff
RENOVAI_STAFF_TOKEN=change-me

# Where the database, photos and renders are stored
RENOVAI_DATA_DIR=./data

# Price list file in catalog/kober/data/. prices.json is written by `make prices SHEET=...`
# from the team's price sheet; until then the placeholder list is used.
RENOVAI_PRICE_FILE=prices.placeholder.json

# Public address of the app, used in WhatsApp share links (e.g. https://renovai.example.mx)
RENOVAI_PUBLIC_URL=
